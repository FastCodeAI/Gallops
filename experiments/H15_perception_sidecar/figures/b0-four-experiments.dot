// H15 Part B (docs/drivejepa-perception-sidecar/part-b/B-0-foundations.md, top): the experiments in one picture, as
// renumbered on 13 Nov (D28; the file keeps its name). Left, Drive-JEPA as it
// runs at inference, frozen; right, the side-car and its agents; between them, each experiment beside the part of the
// planner it changes, with what it tests. Grey: the release, frozen. Blue: the side-car and its agents. Green: an
// experiment that trains (an adapter, with LoRA or weights). Amber: a rule that trains nothing. Dashed card: not scheduled.
// Render: dot -Tsvg b0-four-experiments.dot -o b0-four-experiments.svg && dot -Tpng:cairo -Gdpi=192 b0-four-experiments.dot -o b0-four-experiments.png
// (not rsvg-convert: version 2.50 drops the space after a bold run)
digraph b0_four_experiments {
  graph [rankdir=TB, fontname="Helvetica", nodesep=0.45, ranksep=0.42, pad=0.3, bgcolor="white", newrank=true,
         labelloc="t", fontsize=13,
         label=<<B>Part B's experiments, and where each fits inside Drive-JEPA</B> <FONT POINT-SIZE="9.5">(renumbered 13 Nov, D28)</FONT><BR/><FONT POINT-SIZE="9.5">grey: the release, frozen · blue: the side-car · green: trains an adapter, with LoRA or weights · amber: a rule, trains nothing · dashed: not scheduled</FONT><BR/> >];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10.5, penwidth=1.2,
         color="#6b7280", fillcolor="#f3f4f6", margin="0.14,0.07"];
  edge  [color="#6b7280", arrowsize=0.65, penwidth=1.0, fontname="Helvetica", fontsize=9];

  // Drive-JEPA at inference, top to bottom.
  cam     [label=<<B>CAM_F0</B><BR/><FONT POINT-SIZE="9">now and 0.5 s earlier</FONT>>, width=3.2];
  vit     [label=<<B>ViT-L (V-JEPA)</B><BR/><FONT POINT-SIZE="9">512 tokens × 1024</FONT>>, width=3.2];
  proj    [label=<<B>projector</B><BR/><FONT POINT-SIZE="9">a 16 × 32 map of 256</FONT>>, width=3.2];
  init    [label=<<B>initial queries</B><BR/><FONT POINT-SIZE="9">32 proposals × 8 poses<BR/>+ the ego's status</FONT>>];
  refiner [label=<<B>refiner: one module, 4 passes</B><BR/><FONT POINT-SIZE="9">each pass decodes 32 proposals × 8 poses (4 s),<BR/>then a BEVFormer layer: self-attention<BR/>and deformable attention to the map</FONT>>, width=3.2];
  scorer  [label=<<B>scorer</B><BR/><FONT POINT-SIZE="9">max over each proposal's 8 poses,<BR/>an MLP: a final score each</FONT>>, width=3.2];
  pick    [label=<<B>pick</B><BR/><FONT POINT-SIZE="9">the highest score: one 4 s plan<BR/>navtest EPDMS 87.78 today</FONT>>, width=3.2];

  // The experiments, each beside what it changes.
  b2 [label=<<B>B-2 · the side-car's hidden layer into the refiner</B> <FONT POINT-SIZE="9">(re-planned 13 Nov)</FONT><BR/><FONT POINT-SIZE="9">changes: the 32 proposals, on every pass, and the pick: the scorer refit downstream<BR/>trains: the read (an adapter) + LoRA or weights; three recipes<BR/><B>tests: does the hidden layer add to the decoded list (HD − D)?</B><BR/>read: EPDMS against C, D and the release; how the 32 change</FONT>>,
      color="#059669", fillcolor="#d1fae5", width=4.3];
  b3 [label=<<B>B-3 · the agents into the scorer alone</B> <FONT POINT-SIZE="9">(was B-2; not scheduled)</FONT><BR/><FONT POINT-SIZE="9">changes: which of the release's own 32 is picked<BR/>trains: an adapter + LoRA on the scorer<BR/><B>tests: does a scorer that reads the agents pick better?</B><BR/>read: the pick's EPDMS, F against C, and against B-1</FONT>>,
      style="rounded,dashed,filled", color="#059669", fillcolor="#ecfdf5", width=4.3];
  b1 [label=<<B>B-1 · the analytic veto</B> <FONT POINT-SIZE="9">(done: no)</FONT><BR/><FONT POINT-SIZE="9">changes: removes proposals that come too close to an agent<BR/>trains: nothing; a rule on clearances<BR/><B>tested: do the agents know of collisions the scorer misses?</B><BR/>read: −0.15 to −0.25 on navtest; the ceiling +1.58</FONT>>,
      color="#d97706", fillcolor="#fef3c7", width=4.3];

  // The side-car, on the right.
  sidecar [label=<<B>side-car (Part A, v3)</B><BR/><FONT POINT-SIZE="9">the same frozen ViT tokens<BR/>18.4 M · 128 slots</FONT>>, color="#2563eb", fillcolor="#dbeafe"];
  agents  [label=<<B>agents, and beneath them the hidden layer</B><BR/><FONT POINT-SIZE="9">the decoded list: class · box · velocity<BR/>1 s path · confidence; clearance to every proposal<BR/>its hidden layer: 128 slots × 384 (B-2)</FONT>>, color="#2563eb", fillcolor="#dbeafe"];

  b0 [shape=note, fillcolor="white", color="#9ca3af", width=9.5,
      label=<<B>B-0 reads them all alike</B><FONT POINT-SIZE="9">: settings chosen on the R-clean split; navtest read once, by NAVSIM's official scorer,<BR/>after the release's 87.78 is reproduced there; every trained arm starts as the release, exactly</FONT>>];

  // The planner's flow.
  cam -> vit -> proj -> refiner -> scorer -> pick;
  init -> refiner;
  vit -> sidecar;
  sidecar -> agents;

  // Each experiment beside its stage: the arrow points into the planner.
  refiner -> b2 [dir=back, color="#059669", style=dashed, penwidth=1.4, label="before every\nBEVFormer layer;\nthe scorer refit"];
  scorer -> b3 [dir=back, color="#059669", style=dashed, penwidth=1.4, label="into each\nproposal's feature"];
  pick -> b1 [dir=back, color="#d97706", style=dashed, penwidth=1.4, label="before the pick"];

  // The side-car feeds every experiment.
  agents -> b2 [color="#2563eb", penwidth=1.1];
  agents -> b3 [color="#2563eb", penwidth=1.1];
  agents -> b1 [color="#2563eb", penwidth=1.1];

  { rank=same; vit; sidecar; }
  { rank=same; init; proj; agents; }
  { rank=same; refiner; b2; }
  { rank=same; scorer; b3; }
  { rank=same; pick; b1; }
  pick -> b0 [style=invis];

  // Columns: the planner straight down; the experiments in one column beside it.
  cam [group=dj]; vit [group=dj]; proj [group=dj]; refiner [group=dj]; scorer [group=dj]; pick [group=dj];
  b2 [group=exp]; b3 [group=exp]; b1 [group=exp];
  b2 -> b3 -> b1 [style=invis, weight=8];
  init -> proj [style=invis];
}
