// H15 rerun, Part A: the side-car alone, in eight steps, each closed by a review before the next opens.
// Blue: done in the planning commit (steps 1-3). Grey: after the owner's review. Amber diamonds: reviews.
// Render: dot -Tsvg part-a-steps.dot -o part-a-steps.svg && dot -Tpng:cairo -Gdpi=192 part-a-steps.dot -o part-a-steps.png
// (not rsvg-convert: version 2.50 drops the space after a bold run)
digraph part_a_steps {
  graph [rankdir=TB, fontname="Helvetica", nodesep=0.35, ranksep=0.32, pad=0.3, bgcolor="white"];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10.5, penwidth=1.2,
         color="#6b7280", fillcolor="#f3f4f6", margin="0.16,0.07", width=5.2];
  edge  [color="#6b7280", arrowsize=0.65, penwidth=1.0, fontname="Helvetica", fontsize=9];

  S1 [label=<<B>Step 1 · the data</B><BR/><FONT POINT-SIZE="9">what one sample is · inputs · labels · targets · splits · statistics<BR/>notebook 01_dataset</FONT>>,
      color="#2563eb", fillcolor="#dbeafe"];
  S2 [label=<<B>Step 2 · the model and its loss</B><BR/><FONT POINT-SIZE="9">architecture · Hungarian matching · each loss term on a toy and a real batch<BR/>notebook 02_loss</FONT>>,
      color="#2563eb", fillcolor="#dbeafe"];
  S3 [label=<<B>Step 3 · the pipeline check</B><BR/><FONT POINT-SIZE="9">preflight · overfit check · epoch 1 of v1's 12-epoch schedule, select logs only<BR/>notebook 03_training</FONT>>,
      color="#2563eb", fillcolor="#dbeafe"];
  R1 [shape=diamond, style="filled", width=2.6, height=0.6, fixedsize=true, color="#d97706", fillcolor="#fef3c7",
      label=<<FONT POINT-SIZE="9.5"><B>owner reviews 1–3</B></FONT>>];
  S4 [label=<<B>Step 4 · pre-register</B><BR/><FONT POINT-SIZE="9">success criteria and predictions committed in PREDICTIONS.md<BR/>before any run that will be reported</FONT>>];
  S5 [label=<<B>Step 5 · train, choosing on select only</B><BR/><FONT POINT-SIZE="9">5a: v1, v2, v3 at seed 0 (12 epochs) and v1 at 24 epochs<BR/>5b: the chosen variant and schedule, seeds 1 and 2 · the blind control</FONT>>];
  R2 [shape=diamond, style="filled", width=2.6, height=0.6, fixedsize=true, color="#d97706", fillcolor="#fef3c7",
      label=<<FONT POINT-SIZE="9.5"><B>owner reviews 5</B></FONT>>];
  S6 [label=<<B>Step 6 · NAVSIM, report logs, read once</B><BR/><FONT POINT-SIZE="9">detection · boxes · velocity · 1 s paths · lead vehicle · sight checks<BR/>notebook 04_evaluation, filled in</FONT>>];
  S7 [label=<<B>Step 7 · nuScenes, out of the box</B><BR/><FONT POINT-SIZE="9">site root · the scene draw committed · extract · pass · the same readout, zero-shot</FONT>>];
  R3 [shape=diamond, style="filled", width=2.6, height=0.6, fixedsize=true, color="#d97706", fillcolor="#fef3c7",
      label=<<FONT POINT-SIZE="9.5"><B>owner reviews 6–7</B></FONT>>];
  S8 [label=<<B>Step 8 · close Part A</B><BR/><FONT POINT-SIZE="9">record · decision · whether, and how narrowly, any B question opens</FONT>>];

  S1 -> S2 -> S3 -> R1 -> S4 -> S5 -> R2 -> S6 -> S7 -> R3 -> S8;

  NOTE [shape=note, style="filled", fillcolor="white", color="#9ca3af", fontsize=9, width=2.4,
        label=<<B>Out of scope until Part A closes</B><BR ALIGN="LEFT"/>B1 scorer · B2 refiner · B3 ViT LoRA<BR ALIGN="LEFT"/>C adapter and gate<BR ALIGN="LEFT"/>>];
  edge [style=invis]; S1 -> NOTE;
  {rank=same; S1; NOTE;}
}
