// H15 Part A: the side-car (sidecar.py), its inputs, one decoder layer, its heads, its loss and its readout.
// Grey: frozen or cached. Blue: trained. Green: the loss (training only). Amber: what a person or planner reads.
// Sizes are v1's (d = 256, 3 layers, 64 queries); v2 and v3 change only d, the number of layers and of queries.
// Render: dot -Tsvg part-a-sidecar.dot -o part-a-sidecar.svg && dot -Tpng:cairo -Gdpi=192 part-a-sidecar.dot -o part-a-sidecar.png
// (not rsvg-convert: version 2.50 drops the space after a bold run)
digraph part_a_sidecar {
  graph [rankdir=TB, fontname="Helvetica", nodesep=0.28, ranksep=0.34, pad=0.3, bgcolor="white", newrank=true];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, penwidth=1.2,
         color="#6b7280", fillcolor="#f3f4f6", margin="0.14,0.06"];
  edge  [color="#6b7280", arrowsize=0.6, penwidth=1.0, fontname="Helvetica", fontsize=8.5];

  subgraph cluster_in {
    label=<<B>Inputs · frozen, cached once</B>>; fontsize=10.5; style="rounded,filled"; color="#9ca3af"; fillcolor="#f9fafb";
    IMG [label=<<B>CAM_F0</B>&nbsp;at t − 0.5 s and t<BR/><FONT POINT-SIZE="8.5">1920×1080 · rows 28–1052 · resized to 512×256</FONT>>];
    VIT [label=<<B>V-JEPA ViT-L/16</B>&nbsp;· released, frozen<BR/><FONT POINT-SIZE="8.5">pixels only: no camera matrix enters it<BR/>tubelet 2: the two frames make one 16×32 grid</FONT>>];
    TOK [label=<<B>ViT-out tokens</B>&nbsp;· 512 × 1024 · fp16<BR/><FONT POINT-SIZE="8.5">tokens-vit-v1 · each token carries the ViT's own position code</FONT>>];
    L2I [label=<<B>lidar2img</B>&nbsp;(CAM_F0, slot 1) × <B>TO_512</B><BR/><FONT POINT-SIZE="8.5">K·[R|t] at 0.4 scale, then the crop and resize<BR/>ego point → pixel of the 512×256 image · 4×4</FONT>>];
    IMG -> VIT -> TOK;
  }

  subgraph cluster_car {
    label=<<B>Side-car · trained · v1 4.39 M</B>>; fontsize=10.5; style="rounded,filled"; color="#2563eb"; fillcolor="#eff6ff";
    node [color="#2563eb", fillcolor="#dbeafe"];
    MEM [label=<<B>memory</B>&nbsp;= LayerNorm(Linear 1024 → d)<BR/><FONT POINT-SIZE="8.5">0.26 M · the values: what each token says</FONT>>];
    RAY [label=<<B>token rays</B>&nbsp;→ position embedding<BR/><FONT POINT-SIZE="8.5">each token's ray at 16 depths, 1–60 m · MLP 48 → 256 → d<BR/>added to the keys only: where each token looks<BR/>NAVSIM's camera barely varies (0.5°): in effect a fixed code</FONT>>];
    QRY [label=<<B>N queries</B>&nbsp;(d) +&nbsp;<B>N reference points</B>&nbsp;(x y z, m)<BR/><FONT POINT-SIZE="8.5">learnt slots (DETR) · points start uniform in x 2–50, |y| &lt; 30, z 0<BR/>32 of v1's 64 start outside the camera's view</FONT>>];
    POS [label=<<B>query position</B>&nbsp;= MLP(reference · (1/64, 1/64, 1/8))<BR/><FONT POINT-SIZE="8.5">3 → 256 → d · gives each slot a place to look from</FONT>>];
    subgraph cluster_layer {
      label=<<B>decoder layer × L</B>&nbsp;· 1.32 M each at d 256>; fontsize=10; style="rounded,filled"; color="#1d4ed8"; fillcolor="#e0ecff";
      SA  [label=<<B>self-attention</B>&nbsp;among the N slots<BR/><FONT POINT-SIZE="8.5">q = k = a + pos · v = a · slots see each other: no duplicates</FONT>>];
      CA  [label=<<B>cross-attention</B>&nbsp;to the 512 tokens<BR/><FONT POINT-SIZE="8.5">q = a + pos · k = memory + rays · v = memory</FONT>>];
      FFN [label=<<B>FFN</B>&nbsp;d → 1024 → d · dropout 0.1>];
      SA -> CA -> FFN;
    }
    subgraph cluster_heads {
      label=<<B>heads · on every layer · one small network per output</B>>; fontsize=10; style="rounded,filled"; color="#1d4ed8"; fillcolor="#e0ecff";
      HC [label=<<B>class</B><BR/><FONT POINT-SIZE="8">Linear → 4 logits<BR/>veh · ped · cyc · none</FONT>>];
      HR [label=<<B>Δcentre</B><BR/><FONT POINT-SIZE="8">MLP → x y z<BR/>zero-init</FONT>>];
      HB [label=<<B>box</B><BR/><FONT POINT-SIZE="8">MLP → log l w h<BR/>sin cos yaw</FONT>>];
      HV [label=<<B>velocity</B><BR/><FONT POINT-SIZE="8">MLP → vx vy<BR/>m/s, ground</FONT>>];
      HP [label=<<B>path</B><BR/><FONT POINT-SIZE="8">MLP → offsets<BR/>+0.5 s, +1.0 s</FONT>>];
    }
    QRY -> POS;
    POS -> SA [label=" pos "];
    FFN -> HC; FFN -> HR; FFN -> HB; FFN -> HV; FFN -> HP;
    HR -> POS [label=" next layer's reference = this centre, detached ", style=dashed, constraint=false];
  }
  TOK -> MEM;
  L2I -> RAY [label=" inverse → each token's ray "];
  MEM -> CA [label=" values (and keys' content) "];
  RAY -> CA [label=" keys' position "];
  QRY -> SA [label=" a "];

  subgraph cluster_loss {
    label=<<B>Loss · training only · every layer, summed</B>>; fontsize=10.5; style="rounded,filled"; color="#15803d"; fillcolor="#f0fdf4";
    node [color="#15803d", fillcolor="#dcfce7"];
    HUN [label=<<B>Hungarian matching</B>&nbsp;per sample, per layer<BR/><FONT POINT-SIZE="8.5">cost = 2 · (− p(true class)) + 0.25 · L1(centre, m)<BR/>each target trains one slot; the rest learn "none"</FONT>>];
    LOS [label=<<B>2 · focal</B>&nbsp;+&nbsp;<B>0.25 · L1 box</B>&nbsp;+&nbsp;<B>0.25 · L1 velocity</B>&nbsp;+&nbsp;<B>0.25 · L1 path</B><BR/><FONT POINT-SIZE="8.5">divided by the batch's targets (path: by its valid steps)<BR/>no gradient leaves the side-car: the ViT is frozen</FONT>>];
    HUN -> LOS;
  }
  TGT [label=<<B>targets</B>&nbsp;(targets.build)<BR/><FONT POINT-SIZE="8.5">veh · ped · cyc within 50 m whose centre projects into the image<BR/>nearest first, at most 64</FONT>>];
  HB -> HUN [style=invis];
  HC -> HUN; HR -> HUN; HB -> HUN; HV -> HUN; HP -> HUN;
  TGT -> HUN;

  OUT [label=<<B>readout</B>&nbsp;· last layer only (evaluate.decode)<BR/><FONT POINT-SIZE="8.5">confidence = 1 − p(none) · a detection when ≥ 0.5<BR/>a list of agents: class, 3D box, velocity, 1 s path<BR/>each with its cross-attention: where it looked</FONT>>,
       color="#d97706", fillcolor="#fef3c7"];
  HC -> OUT; HB -> OUT; HV -> OUT; HP -> OUT;
}
