// H15 Part B (docs/drivejepa-perception-sidecar/part-b/B-0-foundations.md and one document per experiment): the order of work, each block
// closed by the owner's review before the next opens. Blue: done. Grey: not yet run. Amber diamonds: the owner's
// reviews. Nothing trains before B-2, and B-2 waits for the go-ahead. Experiments are named B-<n>-<v> (overview,
// "Naming"; renumbered on 13 Nov, D28).
// Render: dot -Tsvg b-steps.dot -o b-steps.svg && dot -Tpng:cairo -Gdpi=192 b-steps.dot -o b-steps.png
// (not rsvg-convert: version 2.50 drops the space after a bold run)
digraph b_steps {
  graph [rankdir=TB, fontname="Helvetica", nodesep=0.35, ranksep=0.30, pad=0.3, bgcolor="white"];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10.5, penwidth=1.2,
         color="#6b7280", fillcolor="#f3f4f6", margin="0.16,0.07", width=5.8];
  edge  [color="#6b7280", arrowsize=0.65, penwidth=1.0, fontname="Helvetica", fontsize=9];

  R0 [shape=diamond, style="filled", width=3.1, height=0.62, fixedsize=true, color="#d97706", fillcolor="#fef3c7",
      label=<<FONT POINT-SIZE="9.5"><B>owner reviews the plans</B></FONT>>];
  B0 [color="#2563eb", fillcolor="#dbeafe",
      label=<<B>B-0 · foundations (no training) · done</B><BR/><FONT POINT-SIZE="9">B-0-1 the data: navtest, the R-clean split, the side-car's agents · B-0-2 the official scorer, 87.78 reproduced<BR/>B-0-3 the headroom check · B-0-4 the proposal analysis · five cross-fit side-cars (H15.r6–r8)</FONT>>];
  B1 [color="#2563eb", fillcolor="#dbeafe",
      label=<<B>B-1 · the analytic veto (no training) · done</B><BR/><FONT POINT-SIZE="9">B-1-1 the ceiling +1.58 · B-1-2 labelled agents −0.21 · B-1-3 the side-car's −0.19 to −0.25 · B-1-4 −0.15, −0.16<BR/>settings chosen on R-clean's known-command windows · navtest once (H15.r9, r10)</FONT>>];
  RA [shape=diamond, style="filled", width=3.1, height=0.62, fixedsize=true, color="#d97706", fillcolor="#fef3c7",
      label=<<FONT POINT-SIZE="9.5"><B>review · B-2 re-planned (D28)</B></FONT>>];
  B2 [label=<<B>B-2 · the side-car's hidden layer into the refiner, the planner fine-tuned downstream</B><BR/><FONT POINT-SIZE="9">the owner's shortlist and go-ahead · B-2-0: the hidden-state and fold passes, the alignment check · pre-register<BR/>phase 1: C and O under B-2-1, the gate · review · phase 2: D, HD, H6 (H3); B-2-2 and B-2-3 · navtest once</FONT>>];
  RB [shape=diamond, style="filled", width=3.1, height=0.62, fixedsize=true, color="#d97706", fillcolor="#fef3c7",
      label=<<FONT POINT-SIZE="9.5"><B>review · close B-2</B></FONT>>];
  L [style="rounded,dashed,filled", fillcolor="white",
     label=<<B>then, by what B-2 shows</B><BR/><FONT POINT-SIZE="9">B-3, the scorer alone, with slots · B-6 (4 s forecasts) or B-7 (uncertainty) · the gate, closed loop (B-12)</FONT>>];

  R0 -> B0 -> B1 -> RA -> B2 -> RB -> L;
}
