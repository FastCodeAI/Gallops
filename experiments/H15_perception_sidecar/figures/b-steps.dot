// H15 Part B (docs/drivejepa-perception-sidecar/part-b/B-0-foundations.md and one document per experiment): the order of work, each block
// closed by the owner's review before the next opens. Grey: not yet run. Amber diamonds: the owner's reviews.
// Nothing trains before B-2, and B-2 waits for the go-ahead. Experiments are named B-<n>-<v> (overview, "Naming").
// Render: dot -Tsvg b-steps.dot -o b-steps.svg && dot -Tpng:cairo -Gdpi=192 b-steps.dot -o b-steps.png
// (not rsvg-convert: version 2.50 drops the space after a bold run)
digraph b_steps {
  graph [rankdir=TB, fontname="Helvetica", nodesep=0.35, ranksep=0.30, pad=0.3, bgcolor="white"];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10.5, penwidth=1.2,
         color="#6b7280", fillcolor="#f3f4f6", margin="0.16,0.07", width=5.8];
  edge  [color="#6b7280", arrowsize=0.65, penwidth=1.0, fontname="Helvetica", fontsize=9];

  R0 [shape=diamond, style="filled", width=3.1, height=0.62, fixedsize=true, color="#d97706", fillcolor="#fef3c7",
      label=<<FONT POINT-SIZE="9.5"><B>owner reviews the four plans</B></FONT>>];
  B0 [label=<<B>B-0 · foundations (no training)</B><BR/><FONT POINT-SIZE="9">B-0-1 the data: navtest, the R-clean split, the side-car's agents<BR/>B-0-2 the official scorer on stored picks · the release's 87.78 reproduced, or stop<BR/>B-0-3 the headroom check · B-0-4 the proposal analysis</FONT>>];
  B1 [label=<<B>B-1 · the analytic veto (no training)</B><BR/><FONT POINT-SIZE="9">B-1-1 the ceiling · B-1-2 labelled agents · B-1-3 the side-car's agents<BR/>settings chosen on the R-clean split · navtest once</FONT>>];
  RA [shape=diamond, style="filled", width=3.1, height=0.62, fixedsize=true, color="#d97706", fillcolor="#fef3c7",
      label=<<FONT POINT-SIZE="9.5"><B>review · go-ahead to train?</B></FONT>>];
  B2 [label=<<B>B-2 · agents into the scorer</B><BR/><FONT POINT-SIZE="9">pre-register · B-2-1 adapter + LoRA · B-2-2 a new scorer · B-2-3 adapter only<BR/>arms C, F, O · three seeds · navtest once</FONT>>];
  RB [shape=diamond, style="filled", width=3.1, height=0.62, fixedsize=true, color="#d97706", fillcolor="#fef3c7",
      label=<<FONT POINT-SIZE="9.5"><B>review</B></FONT>>];
  B3 [label=<<B>B-3 · agents into the refiner</B><BR/><FONT POINT-SIZE="9">pre-register · B-3-1 adapter + LoRA · B-3-2 H04's agent look · B-3-3 agent-aware start<BR/>best of 32, the proposals' own quality · navtest once</FONT>>];
  RC [shape=diamond, style="filled", width=3.1, height=0.62, fixedsize=true, color="#d97706", fillcolor="#fef3c7",
      label=<<FONT POINT-SIZE="9.5"><B>review</B></FONT>>];
  B4 [label=<<B>B-4 · both, with LoRA</B><BR/><FONT POINT-SIZE="9">pre-register · B-4-1 two stages · B-4-2 joint training, if the scorer limits<BR/>meet or beat the release on navtest · how the proposals change</FONT>>];
  RD [shape=diamond, style="filled", width=3.1, height=0.62, fixedsize=true, color="#d97706", fillcolor="#fef3c7",
      label=<<FONT POINT-SIZE="9.5"><B>review · close Part B's first round</B></FONT>>];

  R0 -> B0 -> B1 -> RA -> B2 -> RB -> B3 -> RC -> B4 -> RD;
}
