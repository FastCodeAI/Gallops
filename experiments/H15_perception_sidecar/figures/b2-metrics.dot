// H15 Part B, B-2 (docs/drivejepa-perception-sidecar/part-b/B-2-hidden-refiner.md): what is measured, where, and how a
// result is read. Left: the headline, from NAVSIM's official scorer on navtest (B-0-2's pipeline, which reproduces
// the release's 87.78). Middle: the vendored per-proposal labels and the proposal analysis (B-0-4). Right: nuScenes.
// Bottom: how a number becomes a verdict: pairing, H15's rule, and the gatekeeping order. Amber: the decision chain.
// Read in code or a record: pdm_scorer.py:58-63 (EPDMS), navtest.py, b_analysis.py, b_report.clustered_se.
// Render: dot -Tsvg b2-metrics.dot -o b2-metrics.svg && dot -Tpng:cairo -Gdpi=192 b2-metrics.dot -o b2-metrics.png
// (not rsvg-convert: version 2.50 drops the space after a bold run)
digraph b2_metrics {
  graph [rankdir=TB, fontname="Helvetica", nodesep=0.35, ranksep=0.34, pad=0.3, bgcolor="white", newrank=true,
         labelloc="t", fontsize=13,
         label=<<B>B-2's metrics: what is measured, by which scorer, and how a result is read</B><BR/><FONT POINT-SIZE="9.5">grey: a measurement · amber: the decision chain, in the order it is read · the headline is official; the vendored labels explain it</FONT><BR/> >];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, penwidth=1.2,
         color="#6b7280", fillcolor="#f3f4f6", margin="0.14,0.07"];
  edge  [color="#6b7280", arrowsize=0.6, penwidth=1.0, fontname="Helvetica", fontsize=8.5];

  formula [width=11, color="#374151", fillcolor="white", penwidth=1.5,
           label=<<B>EPDMS = NC × DAC × DDC × TLC × (5 EP + 5 TTC + 2 LK + 2 HC + 2 EC) / 16</B><BR/><FONT POINT-SIZE="9">NC no at-fault collision · DAC drivable area · DDC driving direction · TLC traffic lights: multiply the whole · EP ego progress · TTC time to collision<BR/>LK lane keeping · HC history comfort · EC two-frame extended comfort: weighted · the human filter forgives a term the human's own plan also fails · release: 87.78</FONT>>];

  official [label=<<B>the headline: official, on navtest</B><BR/><FONT POINT-SIZE="9">navsim's run_pdm_score.py on all 12,146 scenes,<BR/>each arm's picks replayed (replay_agent)<BR/>EPDMS with the human filter, and navsim's CSV score<BR/>every term of the pick, EC included<BR/>momentum off, as the anchor; on, as a second read</FONT>>];
  vendored [label=<<B>the explanation: vendored labels</B><BR/><FONT POINT-SIZE="9">every one of the 32 proposals, 9 columns (no EC)<BR/>best of 32: the most any scorer could pick<BR/>the share of the 32 passing NC and TTC<BR/>the release scorer's pick on the new proposals<BR/>train, select, R-clean, navtest</FONT>>];
  analysis [label=<<B>the proposal analysis (B-0-4)</B><BR/><FONT POINT-SIZE="9">clearance of the pick and the 32 to labelled agents<BR/>the 32's spread: lateral, longitudinal; minADE<BR/>which proposals moved (matched one to one)<BR/>pick switches; steadiness between frames (EC's proxy)<BR/>the subsets: lead vehicle, slowing, agent within 10 m</FONT>>];
  nusc [label=<<B>out of domain: nuScenes</B><BR/><FONT POINT-SIZE="9">the pick's L2 to the human at 1, 2 and 3 s<BR/>collisions within 3 s · minADE of the 32<BR/>the fold side-cars on nuScenes' tokens<BR/>where the first pass found the refit's cost<BR/>and the refiner's gain</FONT>>];
  use [label=<<B>does an arm use its input? (at test)</B><BR/><FONT POINT-SIZE="9">no slots · another log's slots · another fold's side-car<BR/>labelled agents into D's reader<BR/>the read's attention to its "no agent" slot<BR/>deleting the agent it names against a random one</FONT>>];

  pair [width=11, label=<<B>how every comparison is computed</B><BR/><FONT POINT-SIZE="9">paired per navtest scene · standard errors and 95% intervals clustered by log (136 logs) · each seed separately · seed ranges read across the three seeds<BR/><B>H15's rule for "beats":</B> on every seed, beyond the reference arm's seed range and twice the SE · <B>meets R:</B> the interval's low end ≥ −0.4 (H04's half-width) · <B>beats R:</B> above 0</FONT>>];

  chain [shape=plaintext, style="", margin=0, label=<
    <TABLE BORDER="1" COLOR="#d97706" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fffbeb">
      <TR><TD COLSPAN="4"><B>the decision chain, read in this order: a step is read as a claim only if every step above it holds</B></TD></TR>
      <TR><TD ALIGN="LEFT"><B>0</B></TD><TD ALIGN="LEFT"><B>O − C</B>, under B-2-1</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">is there room for any agent input to a learned planner?</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">phase 1's read; the owner decides whether to go on</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>1</B></TD><TD ALIGN="LEFT"><B>HD − D</B>, under B-2-1</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9"><B>the primary:</B> does the hidden layer add to the decoded list?</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">every seed, beyond D's seed range and 2 SE</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>2</B></TD><TD ALIGN="LEFT"><B>HD − C</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">does the side-car help the planner at all?</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">H15's rule against C</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>3</B></TD><TD ALIGN="LEFT"><B>HD against R</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">does it meet, or beat, the release's 87.78?</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">low end ≥ −0.4 (meets) · above 0 (beats), every seed</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>4</B></TD><TD ALIGN="LEFT"><B>H6 − HD</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">can a learned reader replace the analytic geometry?</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">H15's rule against HD</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>5</B></TD><TD ALIGN="LEFT"><B>H3 − H6</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">does an earlier layer carry more?</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">only if H3 runs at 3 seeds</FONT></TD></TR>
      <TR><TD ALIGN="LEFT" COLSPAN="4"><FONT POINT-SIZE="9"><B>reported, never claimed:</B> every other contrast · every comparison across recipes · EC within ± 0.02 of R, or flagged · the 32's spread: no collapse beyond −20%</FONT></TD></TR>
    </TABLE>>];

  formula -> official;
  formula -> vendored [style=invis];
  formula -> analysis [style=invis];
  official -> nusc [style=invis];
  vendored -> use [style=invis];
  nusc -> pair [style=invis];
  use -> pair [style=invis];
  official -> pair [constraint=false];
  pair -> chain [color="#d97706"];

  { rank=same; official; vendored; analysis; }
  { rank=same; nusc; use; }
}
