// H15 Phase B, idea C3 (B-LoRA): the release with the side-car's agents in its refiner and its scorer, adapted by
// LoRA, trained in two stages (docs/drivejepa-perception-sidecar-B.md §4-6). Grey: the release, frozen. Blue: the
// side-car, frozen (Part A, v3). Green: what trains. Every green part's last layer starts at zero, or its LoRA B
// does, so before the first step the model is the release run through the same cached path (R̃).
// Render: dot -Tsvg b-lora.dot -o b-lora.svg && dot -Tpng:cairo -Gdpi=192 b-lora.dot -o b-lora.png
digraph b_lora {
  graph [rankdir=LR, fontname="Helvetica", nodesep=0.3, ranksep=0.42, pad=0.3, bgcolor="white", newrank=true];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10.5, penwidth=1.2,
         color="#6b7280", fillcolor="#f3f4f6", margin="0.14,0.07"];
  edge  [color="#6b7280", arrowsize=0.65, penwidth=1.0, fontname="Helvetica", fontsize=9];

  tokens [label=<<B>cached tokens</B><BR/><FONT POINT-SIZE="9">ViT out 512 × 1024 · projected 512 × 256<BR/>(tokens-vit-v1, tokens-v1)</FONT>>];
  sidecar [label=<<B>side-car v3, seed k</B><BR/><FONT POINT-SIZE="9">frozen · kept epoch</FONT>>, color="#2563eb", fillcolor="#dbeafe"];
  agents [label=<<B>agents</B><BR/><FONT POINT-SIZE="9">F: the side-car's (confidence ≥ 0.5)<BR/>O: the labels' · C: none</FONT>>, color="#2563eb", fillcolor="#dbeafe"];

  subgraph cluster_stage1 {
    label=<<B>stage 1 · the refiner</B><BR/><FONT POINT-SIZE="9">mtd_loss: winner-takes-all to the human + up to 4 good-anchor teachers · 3 epochs</FONT>>;
    fontname="Helvetica"; fontsize=10; style="rounded,dashed"; color="#9ca3af";
    init [label=<<B>initial queries</B><BR/><FONT POINT-SIZE="9">32 × 8 + ego status</FONT>>];
    radapt [label=<<B>RefinerAdapter</B><BR/><FONT POINT-SIZE="9">own half: query + its pose (every arm)<BR/>agent half: attention, clearance-biased (F, O)</FONT>>, color="#059669", fillcolor="#d1fae5"];
    refiner [label=<<B>refiner × 4 passes</B><BR/><FONT POINT-SIZE="9">frozen weights + rank-16 LoRA<BR/>on every linear layer</FONT>>, color="#059669", fillcolor="#ecfdf5"];
  }

  dump [label=<<B>stage 2 · dump and label</B><BR/><FONT POINT-SIZE="9">every row: 32 proposals, pooled features,<BR/>the release head's logits · PDM labels<BR/>of all 32 (vendored scorer)</FONT>>];

  subgraph cluster_stage3 {
    label=<<B>stage 3 · the scorer</B><BR/><FONT POINT-SIZE="9">BCE on the PDM labels of its own refiner's proposals · 10 epochs</FONT>>;
    fontname="Helvetica"; fontsize=10; style="rounded,dashed"; color="#9ca3af";
    sadapt [label=<<B>scorer Adapter</B><BR/><FONT POINT-SIZE="9">own half: shape, ego, logits (every arm)<BR/>agent half: attention + 13 clearance features (F, O)</FONT>>, color="#059669", fillcolor="#d1fae5"];
    scorer [label=<<B>scorer MLP</B><BR/><FONT POINT-SIZE="9">frozen + rank-16 LoRA<BR/>logits = dumped + (new head − release head)</FONT>>, color="#059669", fillcolor="#ecfdf5"];
  }
  pick [label=<<B>pick</B><BR/><FONT POINT-SIZE="9">the vendor's rule: argmax σ(final)</FONT>>];

  tokens -> sidecar -> agents;
  tokens -> refiner [label="projected"];
  init -> refiner;
  radapt -> refiner [label="added to the queries,\nevery pass"];
  agents -> radapt [color="#2563eb"];
  refiner -> dump -> sadapt -> scorer -> pick;
  agents -> sadapt [color="#2563eb"];
}
