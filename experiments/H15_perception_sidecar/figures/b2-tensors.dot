// H15 Part B, B-2 (docs/drivejepa-perception-sidecar/part-b/B-2-hidden-refiner.md): every tensor from the camera to
// the pick, with its shape, for one sample. Left, the release's planner; right, the side-car; between them, what each
// arm hands the adapter. Rounded boxes are modules, square white boxes are tensors. Grey: the release, frozen.
// Blue: the side-car, frozen. Green: what B-2 trains (each output starts at zero). Dashed: training only.
// Shapes are read in code: drive_jepa_model.py, traj_refiner.py, score_module/scorer.py, sidecar.py, scorers.py.
// Render: dot -Tsvg b2-tensors.dot -o b2-tensors.svg && dot -Tpng:cairo -Gdpi=192 b2-tensors.dot -o b2-tensors.png
// (not rsvg-convert: version 2.50 drops the space after a bold run)
digraph b2_tensors {
  graph [rankdir=TB, fontname="Helvetica", nodesep=0.35, ranksep=0.3, pad=0.3, bgcolor="white", newrank=true,
         labelloc="t", fontsize=13,
         label=<<B>B-2's inputs, outputs and every tensor between them, for one sample</B><BR/><FONT POINT-SIZE="9.5">rounded: a module · square: a tensor, with its shape · grey: the release, frozen · blue: the side-car, frozen · green: what B-2 trains · dashed: training only</FONT><BR/> >];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, penwidth=1.2,
         color="#6b7280", fillcolor="#f3f4f6", margin="0.12,0.06"];
  edge  [color="#6b7280", arrowsize=0.6, penwidth=1.0, fontname="Helvetica", fontsize=8.5];

  // ---- The input, shared.
  img [shape=box, style="filled", fillcolor="white", color="#9ca3af",
       label=<<B>input: CAM_F0, two frames</B><BR/><FONT POINT-SIZE="9">t − 0.5 s and t · rows 28–1052, resized to 512 × 256<BR/>2 × 3 × 256 × 512</FONT>>];
  vit [label=<<B>ViT-L (V-JEPA)</B><BR/><FONT POINT-SIZE="9">304 M · tubelet 2 fuses the two frames · RoPE</FONT>>];
  tok [shape=box, style="filled", fillcolor="white", color="#9ca3af",
       label=<<B>ViT-out tokens</B><BR/><FONT POINT-SIZE="9">512 × 1024: a 16 × 32 grid of 16-pixel patches<BR/>fp16, cached (tokens-vit-*)</FONT>>];

  // ---- The planner (left).
  projm [label=<<B>projector</B><BR/><FONT POINT-SIZE="9">Linear 1024 → 256</FONT>>];
  map [shape=box, style="filled", fillcolor="white", color="#9ca3af",
       label=<<B>image map</B><BR/><FONT POINT-SIZE="9">16 × 32 × 256 · cached (tokens-*)<BR/>what deformable attention samples</FONT>>];
  ego [shape=box, style="filled", fillcolor="white", color="#9ca3af",
       label=<<B>ego status</B><BR/><FONT POINT-SIZE="9">11 numbers → Linear → 256</FONT>>];
  q0 [shape=box, style="filled", fillcolor="white", color="#9ca3af",
      label=<<B>queries q₀</B><BR/><FONT POINT-SIZE="9">256 × 256: 32 proposals × 8 poses,<BR/>learned, + the ego's encoding</FONT>>];
  dec [label=<<B>decoder MLP</B><BR/><FONT POINT-SIZE="9">256 → 1024 → 1024 → 3, per query</FONT>>];
  pk [shape=box, style="filled", fillcolor="white", color="#9ca3af",
      label=<<B>proposals pₖ</B><BR/><FONT POINT-SIZE="9">32 × 8 × 3: x, y, heading<BR/>at 0.5, 1.0, … 4.0 s</FONT>>];
  adapter [color="#059669", fillcolor="#d1fae5",
           label=<<B>adapter: the side-car read</B><BR/><FONT POINT-SIZE="9">reads qₖ₋₁, pₖ and the arm's tokens<BR/>δₖ: 256 × 256, added to qₖ₋₁<BR/>output layer at zero</FONT>>];
  bev [color="#059669", fillcolor="#ecfdf5",
       label=<<B>BEVFormer layer</B><BR/><FONT POINT-SIZE="9">self-attention among the 256 · deformable attention<BR/>to the map at points projected from pₖ · FFN<BR/>LoRA or weights train (by recipe)</FONT>>];
  qk [shape=box, style="filled", fillcolor="white", color="#9ca3af",
      label=<<B>queries qₖ</B><BR/><FONT POINT-SIZE="9">256 × 256</FONT>>];
  loop [shape=note, fillcolor="white", color="#9ca3af",
        label=<<FONT POINT-SIZE="9"><B>× 4 passes, one shared module</B> (k = 1 … 4)<BR ALIGN="LEFT"/>p₁ is decoded before any δ: agent-blind<BR ALIGN="LEFT"/>p₂ … p₄ follow δ₁ … δ₃; δ₄ reaches only the scorer<BR ALIGN="LEFT"/></FONT>>];
  p4 [shape=box, style="filled", fillcolor="white", color="#9ca3af", penwidth=1.6,
      label=<<B>output: the 32 candidate plans p₄</B><BR/><FONT POINT-SIZE="9">32 × 8 × 3</FONT>>];
  pool [shape=box, style="filled", fillcolor="white", color="#9ca3af",
        label=<<B>pooled f</B><BR/><FONT POINT-SIZE="9">q₄ → max over each proposal's 8 poses<BR/>32 × 256</FONT>>];
  scorer [color="#059669", fillcolor="#ecfdf5",
          label=<<B>scorer MLP</B><BR/><FONT POINT-SIZE="9">256 → 1024 → 1024 → 6<BR/>LoRA or weights train (by recipe)</FONT>>];
  logits [shape=box, style="filled", fillcolor="white", color="#9ca3af",
          label=<<B>logits</B><BR/><FONT POINT-SIZE="9">32 × 6: DDC, EP, TTC, LK, HC, final<BR/>only the final one is read</FONT>>];
  plan [shape=box, style="filled", fillcolor="white", color="#9ca3af", penwidth=1.6,
        label=<<B>output: the plan</B><BR/><FONT POINT-SIZE="9">argmax of σ(final) → one of the 32<BR/>8 × 3, the trajectory NAVSIM scores</FONT>>];
  aux [style="rounded,dashed,filled", color="#059669", fillcolor="white",
       label=<<B>the release's auxiliary heads (B-2-1 only)</B><BR/><FONT POINT-SIZE="9">from f: each proposal's collision and TTC agents,<BR/>40 steps × 2 agents × (4 corners + presence)<BR/>from the queries: the drivable area</FONT>>];

  // ---- The side-car (right).
  scproj [color="#2563eb", fillcolor="#dbeafe",
          label=<<B>input projection</B><BR/><FONT POINT-SIZE="9">Linear 1024 → 384 + LayerNorm</FONT>>];
  mem [shape=box, style="filled", fillcolor="white", color="#93c5fd",
       label=<<B>memory</B><BR/><FONT POINT-SIZE="9">512 × 384: the cross-attention's values</FONT>>];
  rays [shape=box, style="filled", fillcolor="white", color="#93c5fd",
        label=<<B>ray code</B><BR/><FONT POINT-SIZE="9">each token's ray at 16 depths, 1–60 m<BR/>→ MLP → 512 × 384, added to the keys only</FONT>>];
  slots0 [shape=box, style="filled", fillcolor="white", color="#93c5fd",
          label=<<B>128 learned slots</B><BR/><FONT POINT-SIZE="9">a₀: 128 × 384 · reference points ref₀: 128 × 3</FONT>>];
  layers [color="#2563eb", fillcolor="#dbeafe",
          label=<<B>6 decoder layers</B><BR/><FONT POINT-SIZE="9">self-attention among slots · cross-attention<BR/>to the 512 tokens · FFN · refℓ = refℓ₋₁ + ref_mlp(aℓ)</FONT>>];
  hid [shape=box, style="filled", fillcolor="white", color="#2563eb", penwidth=1.6,
       label=<<B>the hidden layer, per layer ℓ</B><BR/><FONT POINT-SIZE="9">aℓ: 128 × 384 (no final norm) · refℓ: 128 × 3<BR/>B-2 reads ℓ = 6 (HD, H6) and ℓ = 3 (H3)</FONT>>];
  heads [color="#2563eb", fillcolor="#dbeafe",
         label=<<B>heads on aℓ</B><BR/><FONT POINT-SIZE="9">class 4 (3 + none) · box 8: centre = refℓ,<BR/>log l, w, h, sin and cos yaw · velocity 2<BR/>path 2 × 2: offsets at 0.5 and 1.0 s</FONT>>];
  decl [shape=box, style="filled", fillcolor="white", color="#2563eb",
        label=<<B>the decoded list</B><BR/><FONT POINT-SIZE="9">confidence 1 − p(none) ≥ 0.5: 4.75 slots a row<BR/>18 numbers each: class, confidence, centre,<BR/>size, yaw, velocity, path</FONT>>];

  // ---- What each arm hands the adapter (middle).
  tokens [shape=plaintext, style="", margin=0, label=<
    <TABLE BORDER="1" COLOR="#2563eb" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#eff6ff">
      <TR><TD COLSPAN="2"><B>the arm's tokens, and what biases attention to them</B></TD></TR>
      <TR><TD ALIGN="LEFT" VALIGN="TOP"><B>D</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">A kept agents × 18 → MLP → A × 128 · bias −clearance / 5 for each<BR ALIGN="LEFT"/>(pose, agent): 32 × 8 × A · + 13 clearance features: 32 × 13</FONT></TD></TR>
      <TR><TD ALIGN="LEFT" VALIGN="TOP"><B>HD</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">D's tokens + LayerNorm(a₆) → 128, for each kept agent; D's bias</FONT></TD></TR>
      <TR><TD ALIGN="LEFT" VALIGN="TOP"><B>H6</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">all 128 slots: LayerNorm(a₆) → 128, + a code of ref₆ (MLP);<BR ALIGN="LEFT"/>bias log(confidence); no clearance</FONT></TD></TR>
      <TR><TD ALIGN="LEFT" VALIGN="TOP"><B>H3</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">as H6, with a₃ and ref₃</FONT></TD></TR>
      <TR><TD ALIGN="LEFT" VALIGN="TOP"><B>O</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">labelled agents in CAM_F0's view, within 50 m, as D's (confidence 1)</FONT></TD></TR>
      <TR><TD ALIGN="LEFT" VALIGN="TOP"><B>C</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">none: the adapter's own half only (query + pose)</FONT></TD></TR>
      <TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="9">a learned "no agent" slot is always there to attend to · the fold's input map, if alignment needs one</FONT></TD></TR>
    </TABLE>>];

  // ---- The training targets (not inputs).
  targets [shape=note, fillcolor="white", color="#9ca3af",
           label=<<B>training targets, never inputs</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">the human's plan: 8 × 3 · up to 4 good anchors (teachers): 4 × 8 × 3<BR ALIGN="LEFT"/>PDM labels of the 32: 32 × 9 (NC, DAC, TLC, DDC, EP, TTC, LK, HC, final)<BR ALIGN="LEFT"/>   online in B-2-1; from the dump, vendored, in B-2-2 and B-2-3<BR ALIGN="LEFT"/>the auxiliaries' targets, from the metric cache (B-2-1)<BR ALIGN="LEFT"/></FONT>>];

  // Edges: shared input.
  img -> vit -> tok;
  // Planner.
  tok -> projm -> map;
  ego -> q0;
  q0 -> dec -> pk;
  pk -> adapter;
  q0 -> adapter [label=" qₖ₋₁"];
  adapter -> bev [color="#059669", penwidth=1.4, label=" qₖ₋₁ + δₖ"];
  pk -> bev [label=" where to sample"];
  map -> bev;
  bev -> qk;
  qk -> loop [style=dashed, arrowhead=none];
  qk -> p4 [label=" after pass 4"];
  qk -> pool [label=" q₄"];
  pool -> scorer -> logits -> plan;
  p4 -> plan;
  pool -> aux [style=dashed, color="#059669"];
  // Side-car.
  tok -> scproj [color="#2563eb"];
  scproj -> mem [color="#2563eb"];
  rays -> layers [color="#2563eb", label=" keys"];
  mem -> layers [color="#2563eb", label=" values"];
  slots0 -> layers [color="#2563eb"];
  layers -> hid [color="#2563eb"];
  hid -> heads [color="#2563eb"];
  heads -> decl [color="#2563eb"];
  // Hand-over.
  hid -> tokens [color="#2563eb", penwidth=1.3, label=" HD, H6, H3", weight=0];
  decl -> tokens [color="#2563eb", penwidth=1.3, label=" D, HD"];
  adapter -> tokens [dir=back, color="#2563eb", penwidth=1.4, label=" tokens"];
  logits -> targets [style=invis];

  // Ranks and left-to-right order: the planner on the left, the side-car on the right, the hand-over beside the adapter.
  { rank=same; projm; scproj; }
  { rank=same; map; ego; slots0; mem; rays; }
  { rank=same; q0; layers; }
  { rank=same; dec; hid; }
  { rank=same; pk; heads; }
  { rank=same; decl; }
  { rank=same; adapter; tokens; }
  { rank=same; logits; aux; }
  projm -> scproj [style=invis];
  map -> ego -> slots0 -> mem -> rays [style=invis];
  q0 -> layers [style=invis];
  dec -> hid [style=invis];
  pk -> heads [style=invis];
  heads -> decl [style=invis, weight=5];
  decl -> tokens [style=invis];
}
