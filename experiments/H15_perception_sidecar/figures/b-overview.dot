// H15 overview (docs/drivejepa-perception-sidecar/README.md): Part A, the side-car, and Part B, its uses in the
// planner, as experiments B-<n>-<v> (renumbered on 13 Nov, D28). Blue: done. Grey: planned, not run. Amber diamonds:
// the owner's reviews. Nothing in Part B trains before the owner's go-ahead.
// Render: dot -Tsvg b-overview.dot -o b-overview.svg && dot -Tpng:cairo -Gdpi=192 b-overview.dot -o b-overview.png
// (not rsvg-convert: version 2.50 drops the space after a bold run)
digraph b_overview {
  graph [rankdir=LR, fontname="Helvetica", nodesep=0.28, ranksep=0.40, pad=0.3, bgcolor="white", newrank=true];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10.5, penwidth=1.2,
         color="#6b7280", fillcolor="#f3f4f6", margin="0.14,0.07"];
  edge  [color="#6b7280", arrowsize=0.65, penwidth=1.0, fontname="Helvetica", fontsize=9];

  subgraph cluster_a {
    label=<<B>Part A · the side-car</B><BR/><FONT POINT-SIZE="9">docs/drivejepa-perception-sidecar/part-a/plan.md</FONT>>;
    fontname="Helvetica"; fontsize=10; style="rounded,dashed"; color="#9ca3af";
    a15 [label=<<B>steps 1–5</B><BR/><FONT POINT-SIZE="9">v3, 24 epochs · select F1 0.717</FONT>>, color="#2563eb", fillcolor="#dbeafe"];
    a7  [label=<<B>step 7 · nuScenes</B><BR/><FONT POINT-SIZE="9">vehicles 0.53 · Q9 holds</FONT>>, color="#2563eb", fillcolor="#dbeafe"];
    a6  [label=<<B>step 6 · report logs</B><BR/><FONT POINT-SIZE="9">waits for the owner</FONT>>];
    a8  [label=<<B>step 8 · close</B>>];
    a15 -> a7 -> a6 -> a8;
  }

  subgraph cluster_b {
    label=<<B>Part B · the side-car in the planner</B><BR/><FONT POINT-SIZE="9">one document each · nothing trains before the go-ahead · renumbered 13 Nov (D28)</FONT>>;
    fontname="Helvetica"; fontsize=10; style="rounded,dashed"; color="#9ca3af";
    b0 [label=<<B>B-0 · foundations</B><BR/><FONT POINT-SIZE="9">data · official scoring · 87.78 reproduced<BR/>headroom check · done</FONT>>, color="#2563eb", fillcolor="#dbeafe"];
    b1 [label=<<B>B-1 · the veto</B><BR/><FONT POINT-SIZE="9">a rule picks around agents<BR/>done: −0.15 to −0.25 · was C4</FONT>>, color="#2563eb", fillcolor="#dbeafe"];
    r1 [shape=diamond, style="filled", width=1.9, height=0.55, fixedsize=true, color="#d97706", fillcolor="#fef3c7", label=<<FONT POINT-SIZE="9"><B>review</B></FONT>>];
    b2 [label=<<B>B-2 · the hidden layer into the refiner</B><BR/><FONT POINT-SIZE="9">the planner fine-tuned downstream · re-planned 13 Nov<BR/>absorbs the 11 Nov B-3, B-4, B-5 · was C1, C3</FONT>>];
    r2 [shape=diamond, style="filled", width=1.9, height=0.55, fixedsize=true, color="#d97706", fillcolor="#fef3c7", label=<<FONT POINT-SIZE="9"><B>review</B></FONT>>];
    b0 -> b1 -> r1 -> b2 -> r2;
  }

  later [label=<<B>later, by what B-2 shows</B><BR/><FONT POINT-SIZE="9">B-3, the scorer alone (was B-2, C2) · B-4…B-14 (the ideas)<BR/>the gate (B-12)</FONT>>, style="rounded,dashed", fillcolor="white"];
  primer [label=<<B>the LoRA primer</B><BR/><FONT POINT-SIZE="9">what B-2 and B-3 adapt, and how</FONT>>, shape=note, fillcolor="white"];

  a15 -> b0 [label="the agents"];
  r2 -> later;
  primer -> b2 [style=dashed, arrowhead=none];
}
