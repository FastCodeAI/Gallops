// H15 Part A: which agents matter -- the derived labels proposed for review (importance.py; plan §3.8),
// the metrics they give and the loss options they open. Numbers are counted on select, report and 10,000 train
// samples (notebook 01 §8). Grey: what exists. Blue: derived labels. Amber: metrics. Green: loss options.
// Render: dot -Tsvg part-a-importance.dot -o part-a-importance.svg && dot -Tpng:cairo -Gdpi=192 part-a-importance.dot -o part-a-importance.png
// (not rsvg-convert: version 2.50 drops the space after a bold run)
digraph part_a_importance {
  graph [rankdir=LR, fontname="Helvetica", nodesep=0.3, ranksep=0.5, pad=0.3, bgcolor="white", newrank=true];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, penwidth=1.2,
         color="#6b7280", fillcolor="#f3f4f6", margin="0.14,0.06"];
  edge  [color="#6b7280", arrowsize=0.6, penwidth=1.0, fontname="Helvetica", fontsize=8.5];

  LAB [label=<<B>labels</B><BR/><FONT POINT-SIZE="8.5">every agent within 60 m<BR/>+ the ego's logged next 4 s</FONT>>];
  TGT [label=<<B>targets</B>&nbsp;(targets.build)<BR/><FONT POINT-SIZE="8.5">veh · ped · cyc, ≤ 50 m, centre in view<BR/>nearest first · 6.6 a sample</FONT>>];
  LAB -> TGT;

  subgraph cluster_derived {
    label=<<B>Derived · importance.py · proposed</B>>; fontsize=10.5; style="rounded,filled"; color="#2563eb"; fillcolor="#eff6ff";
    node [color="#2563eb", fillcolor="#dbeafe"];
    VIS [label=<<B>visible</B>&nbsp;(line of sight)<BR/><FONT POINT-SIZE="8.5">≥ 50% of its image box uncovered by nearer agents<BR/>44% of targets · 74% within 20 m, 33% beyond 30 m</FONT>>];
    PATH [label=<<B>in the ego's path</B><BR/><FONT POINT-SIZE="8.5">now, +0.5 s or +1.0 s inside the 4 s corridor<BR/>2.3% of targets</FONT>>];
    CAU [label=<<B>causal</B><BR/><FONT POINT-SIZE="8.5">visible and (in the path or within 10 m)<BR/>3.4% of targets · 0.23 a sample · 1 sample in 5<BR/>looser settings: up to 10% (notebook 01 §8)</FONT>>];
    GRP [label=<<B>pedestrian groups</B><BR/><FONT POINT-SIZE="8.5">chained within 1.0 m: half of all pedestrians<BR/>(0.5 m: 4%; 1.5 m chains whole crowds)</FONT>>];
    RNK [label=<<B>nearest-first rank</B><BR/><FONT POINT-SIZE="8.5">the nearest is visible 95% of the time<BR/>the 5th 42%, the 10th 20%</FONT>>];
    VIS -> CAU; PATH -> CAU;
  }
  TGT -> VIS; TGT -> PATH; TGT -> GRP; TGT -> RNK;

  subgraph cluster_metrics {
    label=<<B>Metrics · proposed for step 6 (notebook 04 §4e)</B>>; fontsize=10.5; style="rounded,filled"; color="#d97706"; fillcolor="#fffbeb";
    node [color="#d97706", fillcolor="#fef3c7"];
    M1 [label=<<B>causal recall</B>&nbsp;· the proposed headline<BR/><FONT POINT-SIZE="8.5">epoch 1, select: 0.70 (all targets to 50 m: 0.23)</FONT>>];
    M2 [label=<<B>visible / hidden recall</B><BR/><FONT POINT-SIZE="8.5">epoch 1: 0.35 / 0.14</FONT>>];
    M3 [label=<<B>group-aware recall and precision</B><BR/><FONT POINT-SIZE="8.5">one detection per group is enough</FONT>>];
    M4 [label=<<B>nearest-k recall</B>,&nbsp;k = 1, 3, 5<BR/><FONT POINT-SIZE="8.5">epoch 1: 0.56, 0.40, 0.32</FONT>>];
  }
  CAU -> M1; VIS -> M2; GRP -> M3; RNK -> M4;

  subgraph cluster_loss {
    label=<<B>Loss options · the owner's call (plan §11.9)</B>>; fontsize=10.5; style="rounded,filled"; color="#15803d"; fillcolor="#f0fdf4";
    node [color="#15803d", fillcolor="#dcfce7"];
    W  [label=<<B>importance weights</B><BR/><FONT POINT-SIZE="8.5">1 causal · λ visible · λₕ hidden<BR/>at step 0, hidden targets carry 66% of the box term (one batch)</FONT>>];
    IG [label=<<B>ignore regions</B><BR/><FONT POINT-SIZE="8.5">no penalty for finding a hidden, non-causal agent<BR/>and none for missing it</FONT>>];
    GT [label=<<B>group targets</B><BR/><FONT POINT-SIZE="8.5">one target per group; the other members ignored</FONT>>];
  }
  CAU -> W; VIS -> IG; GRP -> GT;
}
