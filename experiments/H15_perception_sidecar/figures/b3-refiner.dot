// H15 Part B, B-3 (docs/drivejepa-perception-sidecar-B-3-refiner.md): the side-car's agents into the refiner, so the
// 32 proposals themselves can change. The refiner is one module run four times; a pre-hook adds the adapter's output
// to its queries before every BEVFormer layer. Pass 1's proposals are decoded before any hook acts.
// Grey: frozen. Blue: the agents. Green: what trains.
// Render: dot -Tsvg b3-refiner.dot -o b3-refiner.svg && dot -Tpng:cairo -Gdpi=192 b3-refiner.dot -o b3-refiner.png
digraph b3_refiner {
  graph [rankdir=LR, fontname="Helvetica", nodesep=0.28, ranksep=0.36, pad=0.3, bgcolor="white", newrank=true];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, penwidth=1.2,
         color="#6b7280", fillcolor="#f3f4f6", margin="0.12,0.06"];
  edge  [color="#6b7280", arrowsize=0.6, penwidth=1.0, fontname="Helvetica", fontsize=8.5];

  init [label=<<B>initial queries</B><BR/><FONT POINT-SIZE="8.5">32 × 8 + ego status<BR/>(B-3-3: + the agents)</FONT>>];
  dec1 [label=<<B>decode 1</B><BR/><FONT POINT-SIZE="8.5">proposals, pass 1<BR/>agent-blind</FONT>>];
  bev1 [label=<<B>BEVFormer 1</B>>];
  dec2 [label=<<B>decode 2</B>>];
  bev2 [label=<<B>BEVFormer 2</B>>];
  dec3 [label=<<B>decode 3</B>>];
  bev3 [label=<<B>BEVFormer 3</B>>];
  dec4 [label=<<B>decode 4</B><BR/><FONT POINT-SIZE="8.5">the 32 proposals</FONT>>];
  bev4 [label=<<B>BEVFormer 4</B><BR/><FONT POINT-SIZE="8.5">its queries go to<BR/>the scorer only</FONT>>];
  scorer [label=<<B>scorer</B><BR/><FONT POINT-SIZE="8.5">the release's, frozen (B-3)<BR/>retrained in B-4</FONT>>];

  agents [label=<<B>agents</B><BR/><FONT POINT-SIZE="8.5">F: the side-car's<BR/>O: the labels' · C: none</FONT>>, color="#2563eb", fillcolor="#dbeafe"];
  adapter [label=<<B>RefinerAdapter (B-3-1)</B><BR/><FONT POINT-SIZE="8.5">own half: each query + its pose<BR/>agent half: attention biased by the clearance<BR/>to that query's proposal · output starts at 0<BR/>B-3-2: H04's agent look instead</FONT>>, color="#059669", fillcolor="#d1fae5"];
  lora [label=<<B>LoRA, rank 16</B><BR/><FONT POINT-SIZE="8.5">on all 13 linear layers of the one<BR/>shared refiner: 177,200 parameters</FONT>>, color="#059669", fillcolor="#ecfdf5"];

  init -> dec1 -> bev1 -> dec2 -> bev2 -> dec3 -> bev3 -> dec4 -> bev4 -> scorer;
  dec4 -> scorer [label="proposals", style=dashed];
  agents -> adapter [color="#2563eb"];
  adapter -> bev1 [color="#059669", style=dashed];
  adapter -> bev2 [color="#059669", style=dashed];
  adapter -> bev3 [color="#059669", style=dashed];
  adapter -> bev4 [color="#059669", style=dashed];
  lora -> bev2 [color="#059669", style=dotted, arrowhead=none, label="every pass"];
  { rank=same; adapter; lora; }
}
