+    # ---- [S4] slim write-through copy -----------------------------------------------------------------------------------------
+    # One pad_feature.gz is 1.8-2.5 MB and the NAS delivers ~25 samples/s (bandwidth-bound), i.e. 1.7 h per pass over 149k draws.
+    # The model reads camera_feature_1/2 (drive_jepa_model.py:53-54), lidar2img, img_shape (bevformer/encoder.py:123-142) and
+    # ego_status; the 2x3x448x768 `camera_feature` is never read. The two 512x256 inputs are exactly uint8/255, so they are kept
+    # as lossless PNG (~0.3 MB per sample) and every write is verified bit-identical against the original tensors before it lands.
+    SLIM_KEYS = ("lidar2img", "img_shape", "ego_status")
+
+    def _slim_path(self, token: str, token_path: Path) -> Path:
+        return self._slim_root / token_path.parent.name / f"{token}.npz"
+
+    def _slim_decode(self, z):
+        import cv2
+        import numpy as np
+
+        feats = {
+            k: torch.from_numpy(np.ascontiguousarray(cv2.imdecode(z[p], cv2.IMREAD_UNCHANGED))).permute(2, 0, 1).to(torch.float32).div(255.0)
+            for k, p in (("camera_feature_1", "png1"), ("camera_feature_2", "png2"))
+        }
+        feats.update({k: torch.from_numpy(z[k]) for k in self.SLIM_KEYS})
+        return feats, {"trajectory": torch.from_numpy(z["trajectory"]), "token": str(z["token"])}
+
+    def _slim_load(self, token: str, token_path: Path):
+        import numpy as np
+
+        p = self._slim_path(token, token_path)
+        try:
+            with np.load(p) as z:
+                return self._slim_decode(z)
+        except FileNotFoundError:
+            return None
+
+    def _slim_write(self, token: str, token_path: Path, features, targets) -> None:
+        import io
+        import os
+        import cv2
+        import numpy as np
+
+        arrs = {}
+        for k, p in (("camera_feature_1", "png1"), ("camera_feature_2", "png2")):
+            u8 = (features[k] * 255.0).round().to(torch.uint8).permute(1, 2, 0).contiguous().numpy()
+            ok, enc = cv2.imencode(".png", u8, [cv2.IMWRITE_PNG_COMPRESSION, 1])
+            assert ok
+            arrs[p] = enc
+        arrs.update({k: features[k].numpy() for k in self.SLIM_KEYS})
+        arrs["trajectory"] = targets["trajectory"].numpy()
+        arrs["token"] = np.array(targets["token"])
+        buf = io.BytesIO()
+        np.savez(buf, **arrs)
+        buf.seek(0)
+        with np.load(buf) as z:  # verify the round trip before anything is written
+            f2, t2 = self._slim_decode(z)
+        for k in ("camera_feature_1", "camera_feature_2") + self.SLIM_KEYS:
+            assert torch.equal(f2[k], features[k]) and f2[k].dtype == features[k].dtype, f"slim copy of {token}:{k} is not bit-identical"
+        assert torch.equal(t2["trajectory"], targets["trajectory"]) and t2["trajectory"].dtype == targets["trajectory"].dtype and t2["token"] == targets["token"]
+        p = self._slim_path(token, token_path)
+        p.parent.mkdir(parents=True, exist_ok=True)
+        tmp = p.with_name(f".{p.name}.{os.getpid()}.tmp")
+        tmp.write_bytes(buf.getvalue())
+        os.replace(tmp, p)
+
+    def _finish(self, token: str, token_path: Path, features, targets):
