+        flag = self.label2_flag(token)
+        targets["has_label2"] = torch.tensor(flag)
+        targets["metric_cache_path"] = str(token_path / "metric_cache.pkl") if flag else ""
+
+        # [S35-1c] ego_status rows are [x, y, heading, vx, vy, ax, ay, command(4)] (drive_jepa_features.py:79-84): slots 5:7.
+        assert features["ego_status"].ndim == 2 and features["ego_status"].shape[-1] == 11, features["ego_status"].shape
+        # [S35-1a] our converter writes 2-4 ego_status rows per sample (history available at the anchor; navtrain always has 4), which
+        # the default collate cannot stack. The model reads only the newest row (drive_jepa_model.py:51 `[:, -1]`), so keep that one.
+        features["ego_status"] = features["ego_status"][-1:].clone()
+        if self._zero_accel:
+            features["ego_status"][..., 5:7] = 0.0
+
         return (features, targets)
 
 
